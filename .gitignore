.DS_Store
.claude/settings.local.json
pcb/.claude/

# pcb: only the KiCad sources (.kicad_pro / .kicad_pcb / .kicad_sch).
# Backups, .kicad_prl, fp-info-cache, plugin settings, autorouter files and
# fabrication outputs stay local; order files go to production/.
pcb/**
!pcb/**/
!pcb/**/*.kicad_pro
!pcb/**/*.kicad_pcb
!pcb/**/*.kicad_sch
!pcb/README.md
!pcb/modules/**
!pcb/**/fp-lib-table
!pcb/**/sym-lib-table
pcb/**/*-backups/

# Trackball case: GPL-3.0, lives in the fork (case/trackball/README.md)
case/trackball/*.stl
production/case_print/trackballcase_low.3mf

# Local ZMK build output (firmware/zmk/build.sh)
firmware/zmk/out/
