config SAGE60_INPUT_ROTATE
    bool "Rotate relative X/Y input by a fixed angle"
    default y
    depends on DT_HAS_SAGE60_INPUT_ROTATE_ENABLED && INPUT

config SAGE60_INPUT_GESTURE
    bool "Turn ball rolls on a held layer into key taps"
    default y
    depends on DT_HAS_SAGE60_INPUT_GESTURE_ENABLED && SAGE60_INPUT_ROTATE
