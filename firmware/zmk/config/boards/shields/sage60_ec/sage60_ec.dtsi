/*
 * Copyright (c) 2026 Diwamoto_
 * SPDX-License-Identifier: MIT
 *
 * Sage60 EC (Topre-style capacitive) - shared by both halves.
 * Controller: XIAO nRF52840 Plus. Sensing: pcb/ec_scan_module
 * (74HC4051 mux -> TLV9061 amp -> ADC, DISCHARGE drains the mux common).
 *
 * Per half: 5 strobes (ROW0..ROW4) x 6 inputs (COL0..COL5), 28 keys.
 * ROW4 is the thumb row and only has COL2..COL5.
 * 74HC4051 channel of each COL: COL0=4 COL1=6 COL2=7 COL3=5 COL4=1 COL5=0
 * (COL6=3 is broken out on the module but unused on sage60).
 *
 * Pins differ per half and live in sage60_ec_left/right.overlay.
 * Keys stay dead until calibrated: build the *_calibrator target, then over
 * USB serial run `ec calibration start`, press every key, `ec calibration save`.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &matrix;
        zmk,physical-layout = &sage60_ec_layout;
    };

    mux: mux {
        compatible = "zmk,gpio-mux";
        gpio-controller;
        #gpio-cells = <2>;
        /* select-gpios / en-gpios per half */
    };

    matrix: matrix {
        compatible = "zmk,kscan-ec-matrix";
        io-channels = <&adc 0>;
        matrix-warm-up-us = <500>;
        matrix-relax-us = <1000>;
        adc-read-settle-us = <1>;
        dynamic-polling-interval;
        /* Calibration knob: raise to make keys trigger deeper (10..90). */
        trigger-percentage = <50>;
        /* strobe-gpios / input-gpios / drain-gpios / power-gpios per half */
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        /* col-offset = 6 on the right half; right inputs are listed inner-first */
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)   RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)   RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)   RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)   RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
                RC(4,2) RC(4,3) RC(4,4) RC(4,5)   RC(4,6) RC(4,7) RC(4,8) RC(4,9)
        >;
    };

    /* Generated from pcb/ec_main + pcb/ec_right switch positions. */
    sage60_ec_layout: physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "Sage60 EC";
        transform = <&default_transform>;

        keys  //                     w   h     x    y     rot    rx   ry
            = <&key_physical_attrs 100 100     0   50       0     0    0> // R0C0
            , <&key_physical_attrs 100 100   100   50       0     0    0> // R0C1
            , <&key_physical_attrs 100 100   200   10       0     0    0> // R0C2
            , <&key_physical_attrs 100 100   300    0       0     0    0> // R0C3
            , <&key_physical_attrs 100 100   400   15       0     0    0> // R0C4
            , <&key_physical_attrs 100 100   500   35       0     0    0> // R0C5
            , <&key_physical_attrs 100 100   860   35       0     0    0> // R0C6
            , <&key_physical_attrs 100 100   960   15       0     0    0> // R0C7
            , <&key_physical_attrs 100 100  1060    0       0     0    0> // R0C8
            , <&key_physical_attrs 100 100  1160   10       0     0    0> // R0C9
            , <&key_physical_attrs 100 100  1260   50       0     0    0> // R0C10
            , <&key_physical_attrs 100 100  1360   50       0     0    0> // R0C11
            , <&key_physical_attrs 100 100     0  150       0     0    0> // R1C0
            , <&key_physical_attrs 100 100   100  150       0     0    0> // R1C1
            , <&key_physical_attrs 100 100   200  110       0     0    0> // R1C2
            , <&key_physical_attrs 100 100   300  100       0     0    0> // R1C3
            , <&key_physical_attrs 100 100   400  115       0     0    0> // R1C4
            , <&key_physical_attrs 100 100   500  135       0     0    0> // R1C5
            , <&key_physical_attrs 100 100   860  135       0     0    0> // R1C6
            , <&key_physical_attrs 100 100   960  115       0     0    0> // R1C7
            , <&key_physical_attrs 100 100  1060  100       0     0    0> // R1C8
            , <&key_physical_attrs 100 100  1160  110       0     0    0> // R1C9
            , <&key_physical_attrs 100 100  1260  150       0     0    0> // R1C10
            , <&key_physical_attrs 100 100  1360  150       0     0    0> // R1C11
            , <&key_physical_attrs 100 100     0  250       0     0    0> // R2C0
            , <&key_physical_attrs 100 100   100  250       0     0    0> // R2C1
            , <&key_physical_attrs 100 100   200  210       0     0    0> // R2C2
            , <&key_physical_attrs 100 100   300  200       0     0    0> // R2C3
            , <&key_physical_attrs 100 100   400  215       0     0    0> // R2C4
            , <&key_physical_attrs 100 100   500  235       0     0    0> // R2C5
            , <&key_physical_attrs 100 100   860  235       0     0    0> // R2C6
            , <&key_physical_attrs 100 100   960  215       0     0    0> // R2C7
            , <&key_physical_attrs 100 100  1060  200       0     0    0> // R2C8
            , <&key_physical_attrs 100 100  1160  210       0     0    0> // R2C9
            , <&key_physical_attrs 100 100  1260  250       0     0    0> // R2C10
            , <&key_physical_attrs 100 100  1360  250       0     0    0> // R2C11
            , <&key_physical_attrs 100 100     0  350       0     0    0> // R3C0
            , <&key_physical_attrs 100 100   100  350       0     0    0> // R3C1
            , <&key_physical_attrs 100 100   200  310       0     0    0> // R3C2
            , <&key_physical_attrs 100 100   300  300       0     0    0> // R3C3
            , <&key_physical_attrs 100 100   400  315       0     0    0> // R3C4
            , <&key_physical_attrs 100 100   500  335       0     0    0> // R3C5
            , <&key_physical_attrs 100 100   860  335       0     0    0> // R3C6
            , <&key_physical_attrs 100 100   960  315       0     0    0> // R3C7
            , <&key_physical_attrs 100 100  1060  300       0     0    0> // R3C8
            , <&key_physical_attrs 100 100  1160  310       0     0    0> // R3C9
            , <&key_physical_attrs 100 100  1260  350       0     0    0> // R3C10
            , <&key_physical_attrs 100 100  1360  350       0     0    0> // R3C11
            , <&key_physical_attrs 100 100   244  410       0     0    0> // R4C2
            , <&key_physical_attrs 100 100   350  417     700   400  467> // R4C3
            , <&key_physical_attrs 100 100   454  438    1500   504  488> // R4C4
            , <&key_physical_attrs 100 100   555  472    2200   605  522> // R4C5
            , <&key_physical_attrs 100 100   805  472 (-2250)   855  522> // R4C6
            , <&key_physical_attrs 100 100   906  438 (-1500)   956  488> // R4C7
            , <&key_physical_attrs 100 100  1010  417  (-750)  1060  467> // R4C8
            , <&key_physical_attrs 100 100  1116  410       0     0    0> // R4C9
            ;
    };
};

&adc {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@0 {
        reg = <0>;
        zephyr,input-positive = <NRF_SAADC_AIN0>; /* P0.02 = ADC */
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 3)>;
        zephyr,resolution = <10>;
    };
};

/* uart0 (D6/D7) and i2c1 (D4/D5) default to pins used here on xiao_ble. */
&uart0 { status = "disabled"; };
&i2c1 { status = "disabled"; };
