 * SPDX-License-Identifier: MIT
 *
 * Sage60 (Cherry MX / mechanical switch version)
 *
 * Split keyboard, 6 columns x 5 rows per half (60 keys total).
 * Controller: XIAO nRF52840 (left) / XIAO nRF52840 Plus (right, with trackball).
 * Diode direction: row2col (diode anode on ROW, cathode toward the switch/COL).
 *
 * GPIO assignment is asymmetric between halves, so the actual row-gpios and
 * col-gpios are defined per-half in sage60_left.overlay / sage60_right.overlay.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &sage60_layout;
    };

    /* Trackball: the right half owns the sensor (device set in
     * sage60_right.overlay), the left half receives it over the split link. */
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackball_split: trackball_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;

        diode-direction = "row2col";
        /* row-gpios and col-gpios are provided per-half in the overlays */
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        /* col-offset is set to 6 on the right half (see sage60_right.overlay) */
// | C0 | C1 | C2 | C3 | C4 | C5 |   | C6 | C7 | C8 | C9 | C10 | C11 |   (C0..C5 left, C6..C11 right)
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)   RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)   RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)   RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)   RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)   RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11)
        >;
    };

    sage60_layout: physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "Sage60";
        transform = <&default_transform>;

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0   16       0     0     0> //  0  R0C0
            , <&key_physical_attrs 100 100  100   16       0     0     0> //  1  R0C1
            , <&key_physical_attrs 100 100  200    4       0     0     0> //  2  R0C2
            , <&key_physical_attrs 100 100  300    0       0     0     0> //  3  R0C3
            , <&key_physical_attrs 100 100  400    8       0     0     0> //  4  R0C4
            , <&key_physical_attrs 100 100  500   18       0     0     0> //  5  R0C5
            , <&key_physical_attrs 100 100  850   18       0     0     0> //  6  R0C6
            , <&key_physical_attrs 100 100  950    8       0     0     0> //  7  R0C7
            , <&key_physical_attrs 100 100 1050    0       0     0     0> //  8  R0C8
            , <&key_physical_attrs 100 100 1150    4       0     0     0> //  9  R0C9
            , <&key_physical_attrs 100 100 1250   16       0     0     0> // 10  R0C10
            , <&key_physical_attrs 100 100 1350   16       0     0     0> // 11  R0C11
            , <&key_physical_attrs 100 100    0  116       0     0     0> // 12  R1C0
            , <&key_physical_attrs 100 100  100  116       0     0     0> // 13  R1C1
            , <&key_physical_attrs 100 100  200  104       0     0     0> // 14  R1C2
            , <&key_physical_attrs 100 100  300  100       0     0     0> // 15  R1C3
            , <&key_physical_attrs 100 100  400  108       0     0     0> // 16  R1C4
            , <&key_physical_attrs 100 100  500  118       0     0     0> // 17  R1C5
            , <&key_physical_attrs 100 100  850  118       0     0     0> // 18  R1C6
            , <&key_physical_attrs 100 100  950  108       0     0     0> // 19  R1C7
            , <&key_physical_attrs 100 100 1050  100       0     0     0> // 20  R1C8
            , <&key_physical_attrs 100 100 1150  104       0     0     0> // 21  R1C9
            , <&key_physical_attrs 100 100 1250  116       0     0     0> // 22  R1C10
            , <&key_physical_attrs 100 100 1350  116       0     0     0> // 23  R1C11
            , <&key_physical_attrs 100 100    0  216       0     0     0> // 24  R2C0
            , <&key_physical_attrs 100 100  100  216       0     0     0> // 25  R2C1
            , <&key_physical_attrs 100 100  200  204       0     0     0> // 26  R2C2
            , <&key_physical_attrs 100 100  300  200       0     0     0> // 27  R2C3
            , <&key_physical_attrs 100 100  400  208       0     0     0> // 28  R2C4
            , <&key_physical_attrs 100 100  500  218       0     0     0> // 29  R2C5
            , <&key_physical_attrs 100 100  850  218       0     0     0> // 30  R2C6
            , <&key_physical_attrs 100 100  950  208       0     0     0> // 31  R2C7
            , <&key_physical_attrs 100 100 1050  200       0     0     0> // 32  R2C8
            , <&key_physical_attrs 100 100 1150  204       0     0     0> // 33  R2C9
            , <&key_physical_attrs 100 100 1250  216       0     0     0> // 34  R2C10
            , <&key_physical_attrs 100 100 1350  216       0     0     0> // 35  R2C11
            , <&key_physical_attrs 100 100    0  316       0     0     0> // 36  R3C0
            , <&key_physical_attrs 100 100  100  316       0     0     0> // 37  R3C1
            , <&key_physical_attrs 100 100  200  304       0     0     0> // 38  R3C2
            , <&key_physical_attrs 100 100  300  300       0     0     0> // 39  R3C3
            , <&key_physical_attrs 100 100  400  308       0     0     0> // 40  R3C4
            , <&key_physical_attrs 100 100  500  318       0     0     0> // 41  R3C5
            , <&key_physical_attrs 100 100  850  318       0     0     0> // 42  R3C6
            , <&key_physical_attrs 100 100  950  308       0     0     0> // 43  R3C7
            , <&key_physical_attrs 100 100 1050  300       0     0     0> // 44  R3C8
            , <&key_physical_attrs 100 100 1150  304       0     0     0> // 45  R3C9
            , <&key_physical_attrs 100 100 1250  316       0     0     0> // 46  R3C10
            , <&key_physical_attrs 100 100 1350  316       0     0     0> // 47  R3C11
            , <&key_physical_attrs 100 100    0  416       0     0     0> // 48  R4C0
            , <&key_physical_attrs 100 100  100  416       0     0     0> // 49  R4C1
            , <&key_physical_attrs 100 100  200  404       0     0     0> // 50  R4C2
            , <&key_physical_attrs 100 100  300  400       0     0     0> // 51  R4C3
            , <&key_physical_attrs 100 100  400  408       0     0     0> // 52  R4C4
            , <&key_physical_attrs 100 100  500  418       0     0     0> // 53  R4C5
            , <&key_physical_attrs 100 100  850  418       0     0     0> // 54  R4C6
            , <&key_physical_attrs 100 100  950  408       0     0     0> // 55  R4C7
            , <&key_physical_attrs 100 100 1050  400       0     0     0> // 56  R4C8
            , <&key_physical_attrs 100 100 1150  404       0     0     0> // 57  R4C9
            , <&key_physical_attrs 100 100 1250  416       0     0     0> // 58  R4C10
            , <&key_physical_attrs 100 100 1350  416       0     0     0> // 59  R4C11
            ;
    };
};

/* uart0 (D6/D7) and i2c1 (D4/D5) default to the matrix pins on xiao_ble. */
&uart0 { status = "disabled"; };
&i2c1 { status = "disabled"; };
