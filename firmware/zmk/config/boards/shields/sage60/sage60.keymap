 * SPDX-License-Identifier: MIT
 *
 * Sage60 MX default keymap (6x5 per half, 60 keys).
 * Key order matches default_transform: row by row, left columns 0-5
 * then right columns 6-11.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5         &kp N6    &kp N7    &kp N8    &kp N9    &kp N0     &kp BSPC
&kp TAB    &kp Q     &kp W     &kp E     &kp R     &kp T          &kp Y     &kp U     &kp I     &kp O     &kp P      &kp BSLH
&kp LCTRL  &kp A     &kp S     &kp D     &kp F     &kp G          &kp H     &kp J     &kp K     &kp L     &kp SEMI   &kp SQT
&kp LSHFT  &kp Z     &kp X     &kp C     &kp V     &kp B          &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH   &kp RSHFT
&kp LCTRL  &kp LGUI  &kp LALT  &mo LOWER &kp SPACE &kp RET        &kp RET   &kp SPACE &mo RAISE &kp RALT  &kp RGUI   &kp RCTRL
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&kp GRAVE  &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT      &kp CARET &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR   &kp DEL
&trans     &kp N1    &kp N2    &kp N3    &kp N4    &kp N5         &kp N6    &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT   &kp BSLH
&trans     &kp N6    &kp N7    &kp N8    &kp N9    &kp N0         &kp LEFT  &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC   &kp PIPE
&trans     &trans    &trans    &trans    &trans    &trans         &trans    &trans    &trans    &trans    &trans     &trans
&trans     &trans    &trans    &trans    &trans    &trans         &trans    &trans    &trans    &trans    &trans     &trans
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&kp F1     &kp F2    &kp F3    &kp F4    &kp F5    &kp F6         &kp F7    &kp F8    &kp F9    &kp F10   &kp F11    &kp F12
&trans     &trans    &trans    &trans    &trans    &trans         &kp HOME  &kp PG_DN &kp PG_UP &kp END   &kp INS    &kp PSCRN
&trans     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp C_VOL_UP &kp C_MUTE
&trans     &bt BT_CLR &out OUT_TOG &trans &trans   &trans         &trans    &kp C_PREV &kp C_PP &kp C_NEXT &kp C_VOL_DN &trans
&studio_unlock &trans &trans    &trans    &trans    &trans         &mkp LCLK &mkp RCLK &trans    &mkp MCLK &trans     &trans
            >;
        };
    };
};
