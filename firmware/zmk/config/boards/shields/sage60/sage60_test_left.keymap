 * SPDX-License-Identifier: MIT
 *
 * Board bring-up keymap: every key types a unique character, no modifiers
 * or layers, so each switch/diode can be checked in a text editor.
 *
 * Left:  R0 a-f, R1 g-l, R2 m-r, R3 s-x, R4 y z 1 2 3 4 (C0 = outer)
 * Right: R0 5-0, R1 - = [ ] \ ;, R2 ' ` , . / !,
 *        R3 @ # $ % ^ &, R4 * ( ) _ + |   (C6 = inner)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        test_layer {
            display-name = "Test";
            bindings = <
&kp A  &kp B  &kp C  &kp D  &kp E  &kp F      &kp N5    &kp N6    &kp N7     &kp N8   &kp N9    &kp N0
&kp G  &kp H  &kp I  &kp J  &kp K  &kp L      &kp MINUS &kp EQUAL &kp LBKT   &kp RBKT &kp BSLH  &kp SEMI
&kp M  &kp N  &kp O  &kp P  &kp Q  &kp R      &kp SQT   &kp GRAVE &kp COMMA  &kp DOT  &kp FSLH  &kp EXCL
&kp S  &kp T  &kp U  &kp V  &kp W  &kp X      &kp AT    &kp HASH  &kp DLLR   &kp PRCNT &kp CARET &kp AMPS
&kp Y  &kp Z  &kp N1 &kp N2 &kp N3 &kp N4     &kp STAR  &kp LPAR  &kp RPAR   &kp UNDER &kp PLUS  &kp PIPE
            >;
        };
    };
};
