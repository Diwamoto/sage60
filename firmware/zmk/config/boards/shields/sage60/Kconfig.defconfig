if SHIELD_SAGE60_LEFT

config ZMK_KEYBOARD_NAME
	default "Sage60"

config ZMK_SPLIT_ROLE_CENTRAL
	default y

endif

if SHIELD_SAGE60_LEFT || SHIELD_SAGE60_RIGHT

config ZMK_SPLIT
	default y

# ec-support-zmk-module defaults this on with ZMK_SLEEP; MX has no ADXL362.
config SLEEP_AWAKE_TRIGGER
	default n

endif
